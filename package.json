{
    "name": "kemraa",
    "version": "0.0.1",
    "private": true,
    "description": "KEMRAA - The Land of the Sun. Powered by THOTH.",
    "packageManager": "pnpm@9.12.0",
    "engines": {
        "node": ">=20.10.0",
        "pnpm": ">=9"
    },
    "scripts": {
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "build": "turbo run build",
        "dev": "turbo run dev --parallel",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "db:generate": "npx prisma generate --schema prisma/schema.prisma",
        "db:migrate": "npx prisma migrate dev --schema prisma/schema.prisma",
        "db:seed": "npx tsx prisma/seed/index.ts",
        "db:studio": "npx prisma studio --schema prisma/schema.prisma",
        "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
        "infra:down": "docker compose -f infra/docker/docker-compose.yml down"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.5",
        "@playwright/test": "^1.62.1",
        "@typescript-eslint/eslint-plugin": "^8.8.1",
        "@typescript-eslint/parser": "^8.8.1",
        "dotenv": "^17.4.2",
        "eslint": "^9.12.0",
        "pdf-parse": "^2.4.5",
        "prettier": "^3.3.3",
        "prisma": "5.22.0",
        "tsx": "^4.19.1",
        "turbo": "^2.1.3",
        "typescript": "^5.6.3"
    },
    "dependencies": {
        "@prisma/client": "5.22.0"
    }
}