{
    "name": "@kemraa/api",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint src/**/*.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "jest --passWithNoTests",
        "seed:admin": "tsx src/seed-roles.ts",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
        "prisma:migrate:deploy": "prisma migrate deploy --schema=../../prisma/schema.prisma"
    },
    "dependencies": {
        "@kemraa/adapter-ai": "workspace:*",
        "@kemraa/adapter-maps": "workspace:*",
        "@kemraa/adapter-notification": "workspace:*",
        "@kemraa/adapter-payment": "workspace:*",
        "@kemraa/adapter-travel": "workspace:*",
        "@kemraa/config": "workspace:*",
        "@kemraa/domain": "workspace:*",
        "@kemraa/money": "workspace:*",
        "@nestjs/common": "^10.4.4",
        "@nestjs/core": "^10.4.4",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^10.4.4",
        "@nestjs/swagger": "^8.1.1",
        "@nestjs/throttler": "^5.2.0",
        "@prisma/client": "^5.20.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^6.1.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "compression": "^1.7.4",
        "express": "^4.19.2",
        "helmet": "^7.2.0",
        "ioredis": "^6.0.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pdfkit": "^0.19.1",
        "reflect-metadata": "^0.2.2",
        "resend": "^6.20.0",
        "rxjs": "^7.8.1",
        "stripe": "^22.5.0",
        "tsconfig-paths": "^4.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.5",
        "@nestjs/testing": "^10.4.4",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.15.47",
        "@types/bcryptjs": "^3.0.0",
        "@types/compression": "^1.7.5",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.7.5",
        "@types/passport-jwt": "^4.0.1",
        "@types/pdfkit": "^0.17.6",
        "@types/supertest": "^7.2.1",
        "jest": "^29.7.0",
        "prisma": "^5.20.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "typescript": "^5.6.3"
    }
