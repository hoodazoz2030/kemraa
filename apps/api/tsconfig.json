{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "types": ["node", "jest"]
  },
  "baseUrl": ".",
    "paths": {
      "@kemraa/adapter-*": ["../../packages/adapters/*/src/index.ts"],
      "@kemraa/*": ["../../packages/*/src/index.ts"]
    },
    "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}